<?xml version="1.0" encoding="utf-8"?>
<!-- 시험판에만: 폰 안 AI(GenieX)는 안드로이드 8.1 이상이라 합칠 때만 낮은 minSdk 를 허용한다(지원 칩 검사는 플러그인이 한다) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="com.geniex.sdk" />
    <application android:extractNativeLibs="true">
        <!-- 다른 앱(TD)이 폰 안 AI 를 쓰는 창구. 밖으로 열지만 같은 서명 키의 앱만 받는다(MementoAiService.caller) -->
        <service
            android:name=".MementoAiService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.github.zeldasky.memento.AI" />
            </intent-filter>
        </service>
    </application>
</manifest>
